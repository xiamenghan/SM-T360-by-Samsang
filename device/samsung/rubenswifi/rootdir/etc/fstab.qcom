# Android fstab file.
# <src>                                                    <mnt_point>            <type>  <mnt_flags and options>                              <fs_mgr_flags>
/dev/block/platform/msm_sdcc.1/by-name/system               /system                ext4    ro,barrier=1                                         wait
/dev/block/platform/msm_sdcc.1/by-name/userdata             /data                  ext4    nosuid,nodev,noatime,barrier=1,noauto_da_alloc       wait,check
/dev/block/platform/msm_sdcc.1/by-name/cache                /cache                 ext4    nosuid,nodev,noatime,barrier=1                       wait,check
/dev/block/platform/msm_sdcc.1/by-name/persist              /persist               ext4    nosuid,nodev,noatime,barrier=1                       wait,check
/dev/block/platform/msm_sdcc.1/by-name/efs                  /efs                   ext4    nosuid,nodev,noatime,barrier=1                       wait,check
/dev/block/platform/msm_sdcc.1/by-name/persdata             /persdata/absolute     ext4    nosuid,nodev,noatime,barrier=1                       wait,check
/dev/block/platform/msm_sdcc.1/by-name/modem                /firmware              vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 wait
# 外置 SD（可拆后盖更换）与 USB OTG
/devices/platform/msm_sdcc.2/mmc_host/mmc1                  auto                   auto    defaults                                             voldmanaged=sdcard1:auto
/devices/platform/msm_hsusb                                 auto                   auto    defaults                                             voldmanaged=usb:auto
